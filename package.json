{
  "name": "fxbc-copilot",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "FXBC Copilot - internal records assistant",
  "scripts": {
    "dev": "vite",
    "api": "node api/dev-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "verify:tools": "node verify-tools.mjs",
    "verify:live": "node --env-file=.env.local verify-tools.mjs --live",
    "predeploy": "npm run verify:tools",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
